rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active');
    }
    function ownsExisting() { return activeUser() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return activeUser() && request.resource.data.userId == request.auth.uid; }

    match /users/{userId} {
      allow create: if false;
      allow read: if activeUser() && userId == request.auth.uid;
      allow update: if activeUser() && userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && ((!('status' in resource.data) && !('status' in request.resource.data))
          || (('status' in resource.data) && request.resource.data.status == resource.data.status));
      allow delete: if false;
    }
    match /applications/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /statusHistory/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if false;
    }
    match /events/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /activityLogs/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if false;
    }
  }
}
